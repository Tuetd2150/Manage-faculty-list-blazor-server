@page "/lecturer-coefficients"

<PageTitle>Quản lý danh mục hệ số giảng viên</PageTitle>

<div class="management-page">
    <div class="page-header">
        <div class="page-heading">
            <h1>Quản lý danh mục hệ số giảng viên</h1>
            <p>Quản lý bậc lương, hệ số lương, mức lương và trạng thái phê duyệt.</p>
        </div>
        <div class="page-actions">
            <label class="import-excel-button">
                Import Excel
                <InputFile OnChange="ImportExcel" accept=".xlsx" />
            </label>
            <FluentButton Appearance="Appearance.Neutral" @onclick="ExportExcel">Export Excel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Add())"
                @onclick="OpenCreateDialog">Thêm mới</FluentButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(notification))
    {
        <FluentMessageBar Intent="@notificationIntent">
            @notification
        </FluentMessageBar>
    }

    <div class="filter-card">
        <div class="filter-grid">
            <FluentStack Class="filter-field keyword-filter" Orientation="Orientation.Vertical" VerticalGap="6" Width="100%">
                <FluentTextField
                    Label="Từ khóa"
                    Placeholder="Bậc, hệ số hoặc mức lương"
                    Immediate="true"
                    @bind-Value="keywordInput"
                    @onkeyup="HandleKeywordKeyUp" />
            </FluentStack>
            <FluentStack Class="filter-field" Orientation="Orientation.Vertical" VerticalGap="6" Width="100%">
                <label>Trạng thái duyệt</label>
                <FluentAutocomplete
                    TOption="SelectOption"
                    OptionText="@(option => option.Text)"
                    MaximumSelectedOptions="1"
                    OnOptionsSearch="SearchStatusOptions"
                    @bind-SelectedOptions="selectedStatusOptions" />
            </FluentStack>
            <FluentButton
                Class="filter-button"
                Appearance="Appearance.Accent"
                IconStart="@(new Icons.Regular.Size20.Search())"
                Type="ButtonType.Button"
                @onclick="ApplyFiltersAsync">
                Tìm kiếm
            </FluentButton>
            <FluentButton
                Class="filter-button"
                Appearance="Appearance.Neutral"
                IconStart="@(new Icons.Regular.Size20.ArrowReset())"
                Type="ButtonType.Button"
                @onclick="ResetFilters">
                Làm mới
            </FluentButton>
        </div>
    </div>

    <div class="grid-card">
        <div class="grid-scroll">
            <FluentDataGrid
                Items="@filteredItems.AsQueryable()"
                Pagination="@pagination"
                TGridItem="LecturerCoefficient"
                Class="management-grid coefficient-grid"
                ResizableColumns="false"
                ShowHover="true"
                RowClass="@(item => "clickable-row")"
                OnRowClick="HandleRowClick"
                GridTemplateColumns="var(--coefficient-columns)">
                <TemplateColumn
                    Class="index-column"
                    Align="Align.Center"
                    Sortable="false"
                    Context="item">
                    <HeaderCellItemTemplate>
                        <span class="index-header">STT</span>
                    </HeaderCellItemTemplate>
                    <ChildContent>
                        <span class="index-value">@GetRowNumber(item)</span>
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Bậc lương" SortBy="@salaryGradeSort" Context="item">
                    Bậc @item.SalaryGrade
                </TemplateColumn>
                <TemplateColumn Title="Hệ số lương" SortBy="@salaryCoefficientSort" Context="item">
                    @item.SalaryCoefficient.ToString("0.00")
                </TemplateColumn>
                <TemplateColumn Title="Mức lương" SortBy="@salaryAmountSort" Context="item">
                    @FormatMoney(item.SalaryAmount)
                </TemplateColumn>
                <TemplateColumn Title="Trạng thái" Context="item">
                    <ApprovalStatusBadge Status="@item.ApprovalStatus" />
                </TemplateColumn>
                <TemplateColumn Title="Thao tác" Context="item">
                    <div @onclick:stopPropagation="true">
                    <FluentStack
                        Class="row-actions"
                        VerticalAlignment="VerticalAlignment.Center"
                        HorizontalGap="6"
                        Wrap="false"
                        Width="auto">
                        @if (item.ApprovalStatus == ApprovalStatus.Pending)
                        {
                            <FluentTooltip Anchor="@($"coefficient-edit-{item.Id}")">Chỉnh sửa</FluentTooltip>
                            <FluentButton Id="@($"coefficient-edit-{item.Id}")" Class="action-button"
                                Appearance="Appearance.Stealth" Size="ControlSize.Small"
                                IconStart="@(new Icons.Regular.Size20.Edit())" AriaLabel="Chỉnh sửa"
                                @onclick="() => OpenEditDialog(item)" />
                            <FluentTooltip Anchor="@($"coefficient-delete-{item.Id}")">Xóa</FluentTooltip>
                            <FluentButton Id="@($"coefficient-delete-{item.Id}")" Class="action-button danger-action"
                                Appearance="Appearance.Stealth" Size="ControlSize.Small"
                                IconStart="@(new Icons.Regular.Size20.Delete())" AriaLabel="Xóa"
                                @onclick="() => AskToDelete(item)" />
                            <FluentTooltip Anchor="@($"coefficient-approval-{item.Id}")">
                                Duyệt
                            </FluentTooltip>
                            <FluentButton
                                Id="@($"coefficient-approval-{item.Id}")"
                                Class="action-button"
                                Appearance="Appearance.Stealth"
                                Size="ControlSize.Small"
                                IconStart="@(new Icons.Regular.Size20.CheckmarkCircle())"
                                AriaLabel="Duyệt"
                                @onclick="() => AskToChangeApproval(item)" />
                        }
                        else
                        {
                            <FluentTooltip Anchor="@($"coefficient-approval-{item.Id}")">
                                Hủy duyệt
                            </FluentTooltip>
                            <FluentButton
                                Id="@($"coefficient-approval-{item.Id}")"
                                Class="action-button danger-action"
                                Appearance="Appearance.Stealth"
                                Size="ControlSize.Small"
                                IconStart="@(new Icons.Regular.Size20.DismissCircle())"
                                AriaLabel="Hủy duyệt"
                                @onclick="() => AskToChangeApproval(item)" />
                        }
                    </FluentStack>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
        </div>

        @if (filteredItems.Count == 0)
        {
            <div class="empty-state">Không tìm thấy hệ số phù hợp.</div>
        }

        <div class="pagination">
            <FluentStack
                Class="page-size"
                VerticalAlignment="VerticalAlignment.Center"
                HorizontalGap="8"
                Width="auto">
                <label>Số dòng/trang</label>
                <FluentSelect
                    TOption="SelectOption"
                    Items="@pageSizeOptions"
                    OptionText="@(option => option.Text)"
                    OptionValue="@(option => option.Value)"
                    @bind-SelectedOption="selectedPageSize"
                    @bind-SelectedOption:after="ChangePageSize" />
            </FluentStack>
            <span class="page-summary">
                Trang @currentPage / @TotalPages · Tổng @filteredItems.Count bản ghi
            </span>
            <FluentStack
                HorizontalAlignment="HorizontalAlignment.End"
                VerticalAlignment="VerticalAlignment.Center"
                HorizontalGap="8">
                <FluentButton
                    Class="pagination-icon-button"
                    Size="ControlSize.Small"
                    IconStart="@(new Icons.Regular.Size20.ChevronLeft())"
                    AriaLabel="Trang trước"
                    Disabled="@(currentPage == 1)"
                    @onclick="GoToPreviousPage" />
                <FluentButton
                    Class="pagination-icon-button"
                    Size="ControlSize.Small"
                    IconStart="@(new Icons.Regular.Size20.ChevronRight())"
                    AriaLabel="Trang sau"
                    Disabled="@(currentPage == TotalPages)"
                    @onclick="GoToNextPage" />
            </FluentStack>
        </div>
    </div>

    <LecturerCoefficientDialog
        IsOpen="@coefficientDialogOpen"
        Mode="@dialogMode"
        Model="@selectedCoefficient"
        SalaryGradeOptions="@CoefficientService.GetSalaryGradeDefaults()"
        IsDuplicate="@CoefficientService.CheckDuplicate"
        OnSave="SaveCoefficient"
        OnCancel="CloseCoefficientDialog" />

    <ConfirmationDialog
        IsOpen="@confirmationDialogOpen"
        Title="@confirmationTitle"
        Message="@confirmationMessage"
        OnConfirm="ConfirmPendingAction"
        OnCancel="CloseConfirmation" />
</div>
