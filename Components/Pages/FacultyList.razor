@page "/faculty-list"

<PageTitle>Quản lý danh sách giảng viên</PageTitle>

<div class="management-page">
    <div class="page-header">
        <div class="page-heading">
            <h1>Quản lý danh sách giảng viên</h1>
            <p>Quản lý hồ sơ, học hàm, học vị và trạng thái duyệt của giảng viên.</p>
        </div>
        <div class="page-actions">
            <label class="import-excel-button">
                Import Excel
                <InputFile OnChange="ImportExcel" accept=".xlsx" />
            </label>
            <FluentButton Appearance="Appearance.Neutral" @onclick="ExportExcel">Export Excel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Add())"
                @onclick="OpenCreateDialog">Thêm mới</FluentButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(notification))
    {
        <FluentMessageBar Intent="@notificationIntent">
            @notification
        </FluentMessageBar>
    }

    <div class="filter-card">
        <div class="filter-grid faculty-filter">
            <FluentStack Class="filter-field keyword-filter" Orientation="Orientation.Vertical" VerticalGap="6" Width="100%">
                <FluentTextField
                    Label="Từ khóa"
                    Placeholder="Họ tên, số điện thoại hoặc email"
                    Immediate="true"
                    @bind-Value="keywordInput"
                    @onkeyup="HandleKeywordKeyUp" />
            </FluentStack>
            <FluentStack Class="filter-field" Orientation="Orientation.Vertical" VerticalGap="6" Width="100%">
                <label>Trạng thái duyệt</label>
                <FluentAutocomplete
                    TOption="SelectOption"
                    OptionText="@(option => option.Text)"
                    Position="SelectPosition.Below"
                    MaximumSelectedOptions="1"
                    OnOptionsSearch="SearchStatusOptions"
                    @bind-SelectedOptions="selectedStatusOptions" />
            </FluentStack>
            <FluentStack Class="filter-field" Orientation="Orientation.Vertical" VerticalGap="6" Width="100%">
                <label>Học vị</label>
                <FluentAutocomplete
                    TOption="SelectOption"
                    OptionText="@(option => option.Text)"
                    Position="SelectPosition.Below"
                    MaximumSelectedOptions="1"
                    OnOptionsSearch="SearchDegreeOptions"
                    @bind-SelectedOptions="selectedDegreeOptions" />
            </FluentStack>
            <FluentButton
                Class="filter-button"
                Appearance="Appearance.Accent"
                IconStart="@(new Icons.Regular.Size20.Search())"
                Type="ButtonType.Button"
                @onclick="ApplyFilters">
                Tìm kiếm
            </FluentButton>
            <FluentButton
                Class="filter-button"
                Appearance="Appearance.Neutral"
                IconStart="@(new Icons.Regular.Size20.ArrowReset())"
                Type="ButtonType.Button"
                @onclick="ResetFilters">
                Làm mới
            </FluentButton>
        </div>
    </div>

    <div class="grid-card">
        <div class="grid-scroll">
            <FluentDataGrid
                Items="@filteredItems.AsQueryable()"
                Pagination="@pagination"
                TGridItem="FacultyMember"
                Class="management-grid faculty-grid"
                ResizableColumns="false"
                ShowHover="true"
                RowClass="@(item => "clickable-row")"
                OnRowClick="HandleRowClick"
                GridTemplateColumns="var(--faculty-columns)">
                <TemplateColumn
                    Class="index-column"
                    Align="Align.Center"
                    Sortable="false"
                    Context="item">
                    <HeaderCellItemTemplate>
                        <span class="index-header">STT</span>
                    </HeaderCellItemTemplate>
                    <ChildContent>
                        <span class="index-value">@GetRowNumber(item)</span>
                    </ChildContent>
                </TemplateColumn>
                <PropertyColumn
                    Title="Họ và tên"
                    Property="@(item => item.FullName)"
                    Sortable="true" />
                <PropertyColumn
                    Title="Số điện thoại"
                    Property="@(item => item.PhoneNumber)"
                    Sortable="false" />
                <TemplateColumn
                    Title="Hệ số giảng viên"
                    SortBy="@lecturerCoefficientSort"
                    Sortable="true"
                    Context="item">
                    @GetCoefficientDisplay(item.LecturerCoefficientId)
                </TemplateColumn>
                <TemplateColumn
                    Title="Trạng thái"
                    Sortable="false"
                    Context="item">
                    <ApprovalStatusBadge Status="@item.ApprovalStatus" />
                </TemplateColumn>
                <TemplateColumn
                    Title="Thao tác"
                    Sortable="false"
                    Context="item">
                    <div @onclick:stopPropagation="true">
                    <FluentStack
                        Class="row-actions"
                        VerticalAlignment="VerticalAlignment.Center"
                        HorizontalGap="6"
                        Wrap="false"
                        Width="auto">
                        @if (item.ApprovalStatus == ApprovalStatus.Pending)
                        {
                            <FluentTooltip Anchor="@($"faculty-edit-{item.Id}")">Chỉnh sửa</FluentTooltip>
                            <FluentButton Id="@($"faculty-edit-{item.Id}")" Class="action-button"
                                Size="ControlSize.Small" Appearance="Appearance.Stealth"
                                IconStart="@(new Icons.Regular.Size20.Edit())" AriaLabel="Chỉnh sửa"
                                @onclick="() => OpenEditDialog(item)" />
                            <FluentTooltip Anchor="@($"faculty-delete-{item.Id}")">Xóa</FluentTooltip>
                            <FluentButton Id="@($"faculty-delete-{item.Id}")" Class="action-button danger-action"
                                Size="ControlSize.Small" Appearance="Appearance.Stealth"
                                IconStart="@(new Icons.Regular.Size20.Delete())" AriaLabel="Xóa"
                                @onclick="() => AskToDelete(item)" />
                            <FluentTooltip Anchor="@($"faculty-approval-{item.Id}")">
                                Duyệt giảng viên
                            </FluentTooltip>
                            <FluentButton
                                Id="@($"faculty-approval-{item.Id}")"
                                Class="action-button"
                                Size="ControlSize.Small"
                                Appearance="Appearance.Stealth"
                                IconStart="@(new Icons.Regular.Size20.CheckmarkCircle())"
                                AriaLabel="Duyệt giảng viên"
                                @onclick="() => AskToChangeApproval(item)" />
                        }
                        else
                        {
                            <FluentTooltip Anchor="@($"faculty-approval-{item.Id}")">
                                Hủy duyệt
                            </FluentTooltip>
                            <FluentButton
                                Id="@($"faculty-approval-{item.Id}")"
                                Class="action-button danger-action"
                                Size="ControlSize.Small"
                                Appearance="Appearance.Stealth"
                                IconStart="@(new Icons.Regular.Size20.DismissCircle())"
                                AriaLabel="Hủy duyệt"
                                @onclick="() => AskToChangeApproval(item)" />
                        }
                    </FluentStack>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
        </div>

        @if (filteredItems.Count == 0)
        {
            <div class="empty-state">Không tìm thấy giảng viên phù hợp.</div>
        }

        <div class="pagination">
            <FluentStack
                Class="page-size"
                VerticalAlignment="VerticalAlignment.Center"
                HorizontalGap="8"
                Width="auto">
                <label>Số dòng/trang</label>
                <FluentSelect
                    TOption="SelectOption"
                    Items="@pageSizeOptions"
                    OptionText="@(option => option.Text)"
                    OptionValue="@(option => option.Value)"
                    @bind-SelectedOption="selectedPageSize"
                    @bind-SelectedOption:after="ChangePageSize" />
            </FluentStack>
            <span class="page-summary">
                Trang @currentPage / @TotalPages · Tổng @filteredItems.Count bản ghi
            </span>
            <FluentStack
                HorizontalAlignment="HorizontalAlignment.End"
                VerticalAlignment="VerticalAlignment.Center"
                HorizontalGap="8">
                <FluentButton
                    Class="pagination-icon-button"
                    Size="ControlSize.Small"
                    IconStart="@(new Icons.Regular.Size20.ChevronLeft())"
                    AriaLabel="Trang trước"
                    Disabled="@(currentPage == 1)"
                    @onclick="GoToPreviousPage" />
                <FluentButton
                    Class="pagination-icon-button"
                    Size="ControlSize.Small"
                    IconStart="@(new Icons.Regular.Size20.ChevronRight())"
                    AriaLabel="Trang sau"
                    Disabled="@(currentPage == TotalPages)"
                    @onclick="GoToNextPage" />
            </FluentStack>
        </div>
    </div>

    <FacultyDialog
        IsOpen="@facultyDialogOpen"
        Mode="@dialogMode"
        Model="@selectedMember"
        LecturerCoefficients="@CoefficientService.GetAll()"
        AcademicRanks="@FacultyService.AcademicRanks"
        Degrees="@FacultyService.Degrees"
        EmailExists="@FacultyService.CheckDuplicateEmail"
        OnSave="SaveFacultyMember"
        OnCancel="CloseFacultyDialog" />

    <ConfirmationDialog
        IsOpen="@confirmationDialogOpen"
        Title="@confirmationTitle"
        Message="@confirmationMessage"
        OnConfirm="ConfirmPendingAction"
        OnCancel="CloseConfirmation" />
</div>
