<ManagementDialogLayout
    IsOpen="@IsOpen"
    Title="@Title"
    HostClass="faculty-dialog-host">
                @if (IsReadOnly)
                {
                    <div class="detail-grid">
                        <div class="detail-item detail-wide">
                            <span>Họ và tên</span>
                            <strong>@editModel.FullName</strong>
                        </div>
                        <div class="detail-item">
                            <span>Số điện thoại</span>
                            <strong>@editModel.PhoneNumber</strong>
                        </div>
                        <div class="detail-item">
                            <span>Ngày sinh</span>
                            <strong>@editModel.DateOfBirth?.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="detail-item detail-wide">
                            <span>Email</span>
                            <strong>@editModel.Email</strong>
                        </div>
                        <div class="detail-item">
                            <span>Bậc lương</span>
                            <strong>
                                @(selectedCoefficient is null
                                    ? "—"
                                    : $"Bậc {selectedCoefficient.SalaryGrade}")
                            </strong>
                        </div>
                        <div class="detail-item">
                            <span>Hệ số lương</span>
                            <strong>
                                @(selectedCoefficient?.SalaryCoefficient.ToString("0.00") ?? "—")
                            </strong>
                        </div>
                        <div class="detail-item">
                            <span>Mức lương</span>
                            <strong>
                                @(selectedCoefficient is null
                                    ? "—"
                                    : FormatMoney(selectedCoefficient.SalaryAmount))
                            </strong>
                        </div>
                        <div class="detail-item">
                            <span>Học hàm</span>
                            <strong>@AcademicRankDisplay</strong>
                        </div>
                        <div class="detail-item">
                            <span>Học vị</span>
                            <strong>@DegreeDisplay</strong>
                        </div>
                        <div class="detail-item">
                            <span>Trạng thái</span>
                            <ApprovalStatusBadge Status="@editModel.ApprovalStatus" />
                        </div>
                    </div>
                    <FluentStack
                        Class="dialog-actions"
                        HorizontalAlignment="HorizontalAlignment.End"
                        HorizontalGap="10">
                        <FluentButton
                            Appearance="Appearance.Accent"
                            Type="ButtonType.Button"
                            @onclick="CancelAsync">
                            Đóng
                        </FluentButton>
                    </FluentStack>
                }
                else
                {
                    <EditForm Model="@editModel" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <div class="form-grid">
                            <div class="form-field detail-wide">
                                <FluentTextField
                                    Label="Họ và tên *"
                                    @bind-Value="editModel.FullName" />
                                <ValidationMessage For="@(() => editModel.FullName)" />
                            </div>
                            <div class="form-field">
                                <FluentTextField
                                    Label="Số điện thoại *"
                                    @bind-Value="editModel.PhoneNumber" />
                                <ValidationMessage For="@(() => editModel.PhoneNumber)" />
                            </div>
                            <div class="form-field">
                                <FluentDatePicker
                                    Label="Ngày sinh *"
                                    Culture="@VietnameseCulture"
                                    @bind-Value="editModel.DateOfBirth" />
                                <ValidationMessage For="@(() => editModel.DateOfBirth)" />
                            </div>
                            <div class="form-field detail-wide">
                                <FluentTextField
                                    Label="Email *"
                                    TextFieldType="TextFieldType.Email"
                                    @bind-Value="editModel.Email" />
                                <ValidationMessage For="@(() => editModel.Email)" />
                                @if (!string.IsNullOrWhiteSpace(emailError))
                                {
                                    <div class="validation-message">@emailError</div>
                                }
                            </div>
                            <div class="form-field">
                                <label>Hệ số giảng viên *</label>
                                <FluentAutocomplete
                                    TOption="LecturerCoefficient"
                                    OptionText="@(item => $"Bậc {item.SalaryGrade} – Hệ số {item.SalaryCoefficient:0.00}")"
                                    Placeholder="-- Chọn hệ số --"
                                    Position="SelectPosition.Above"
                                    MaximumOptionsSearch="@LecturerCoefficients.Count"
                                    MaximumSelectedOptions="1"
                                    OnOptionsSearch="SearchCoefficientOptions"
                                    @bind-SelectedOptions="selectedCoefficientOptions"
                                    @bind-SelectedOptions:after="SynchronizeCoefficient" />
                                <ValidationMessage For="@(() => editModel.LecturerCoefficientId)" />
                            </div>
                            <div class="form-field">
                                <label>Học hàm</label>
                                <FluentAutocomplete
                                    TOption="AcademicRank"
                                    OptionText="@(item => item.Name)"
                                    Position="SelectPosition.Above"
                                    MaximumOptionsSearch="@(AcademicRanks.Count + 1)"
                                    MaximumSelectedOptions="1"
                                    OnOptionsSearch="SearchAcademicRankOptions"
                                    @bind-SelectedOptions="selectedAcademicRankOptions"
                                    @bind-SelectedOptions:after="SynchronizeAcademicRank" />
                            </div>
                            <div class="form-field">
                                <label>Học vị</label>
                                <FluentAutocomplete
                                    TOption="Degree"
                                    OptionText="@(item => item.Name)"
                                    Position="SelectPosition.Above"
                                    MaximumOptionsSearch="@(Degrees.Count + 1)"
                                    MaximumSelectedOptions="1"
                                    OnOptionsSearch="SearchDegreeOptions"
                                    @bind-SelectedOptions="selectedDegreeOptions"
                                    @bind-SelectedOptions:after="SynchronizeDegree" />
                            </div>
                        </div>
                        <FluentStack
                            Class="dialog-actions"
                            HorizontalAlignment="HorizontalAlignment.End"
                            HorizontalGap="10">
                            <FluentButton
                                Appearance="Appearance.Accent"
                                Type="ButtonType.Submit">
                                Lưu
                            </FluentButton>
                            <FluentButton
                                Appearance="Appearance.Neutral"
                                Type="ButtonType.Button"
                                @onclick="CancelAsync">
                                Hủy
                            </FluentButton>
                        </FluentStack>
                    </EditForm>
                }
</ManagementDialogLayout>
